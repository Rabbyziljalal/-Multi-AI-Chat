# === Multi-AI Chatbot Proxy Server ===
# Copy this file to .env and fill in your API keys
# These keys are used by the proxy server (not exposed to the client)

# Server port (default: 3001)
PORT=3001

# OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# BigModel (Zhipu AI) API Key
# Get your key at: https://open.bigmodel.cn/
BIGMODEL_API_KEY=your-bigmodel-api-key-here

# DeepSeek API Key
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Groq API Key
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here

# Google Custom Search API Key
# Get your key at: https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=AIzaSy-your-google-search-api-key-here

# Google Custom Search Engine ID
# Create a CSE at: https://cse.google.com/cse/all
GOOGLE_CSE_ID=your-google-cse-id-here
