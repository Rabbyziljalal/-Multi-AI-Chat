# === Multi-AI Chatbot Proxy Server ===
# Copy this file to .env and fill in your API keys
# These keys are used by the proxy server (not exposed to the client)

# Server port (default: 3001)
PORT=3001

# OpenAI API Key
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# Optional second Gemini API Key — the server rotates between GEMINI_API_KEY
# and GEMINI_API_KEY_2 round-robin to spread usage across both keys.
# Leave blank/remove if you only have one key.
GEMINI_API_KEY_2=AIzaSy-your-second-gemini-api-key-here

# BigModel (Zhipu AI) API Key
# Get your key at: https://open.bigmodel.cn/
BIGMODEL_API_KEY=your-bigmodel-api-key-here

# DeepSeek API Key
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Groq API Key
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here

# OpenRouter API Key (free, no credit card required)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# Cerebras API Key (free, no credit card required)
# Get your key at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your-cerebras-key-here

# Tavily Search API Key
# Get your key at: https://tavily.com/
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Serper Search API Key (fallback if Tavily fails)
# Get your key at: https://serper.dev/
SERPER_API_KEY=your-serper-api-key-here

# Upstash Redis (for the memory system + user accounts)
# Create a free database at: https://console.upstash.com/
# Then copy the REST URL and REST Token from the database details page
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# JWT Secret (for the auth system)
# Any long random string — used to sign login/signup tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-long-random-jwt-secret-here
